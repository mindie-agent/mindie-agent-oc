{
  "mcpServers": {
    "mindie-remote-dev": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-I",
        "-X",
        "utf8",
        "${OC_PLUGIN_ROOT}/scripts/mindie_launch.py",
        "mcp",
        "remote"
      ],
      "cwd": "${OC_PLUGIN_ROOT}",
      "env": {
        "OC_PLUGIN_ROOT": "${OC_PLUGIN_ROOT}",
        "REMOTE_DEV_HARNESS_PROFILE": "oc",
        "REMOTE_DEV_STATE_DIR": "${OC_PLUGIN_DATA}/state/oc/remote",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "alwaysLoad": true,
      "defer_loading": false
    },
    "mindie-tools": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-I",
        "-X",
        "utf8",
        "${OC_PLUGIN_ROOT}/scripts/mindie_launch.py",
        "mcp",
        "tools"
      ],
      "cwd": "${OC_PLUGIN_ROOT}",
      "env": {
        "OC_PLUGIN_ROOT": "${OC_PLUGIN_ROOT}",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "alwaysLoad": true,
      "defer_loading": false
    }
  }
}
